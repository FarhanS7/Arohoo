# -----------------------------------------------------------------------------
# Arohoo Platform - Frontend Environment Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# For production, these variables must be configured in your deployment platform (e.g. Vercel, Docker).

# --- API ---
# Base URL for the Arohoo Backend API
# Ensure this matches the NEXT_PUBLIC_API_URL in the backend config.
NEXT_PUBLIC_API_URL="https://api.arohoo.com/api/v1"
# --- ANALYTICS / MONITORING ---
# NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
